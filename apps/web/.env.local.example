# =============================================================================
# SES Configuration
# =============================================================================
# AWS credentials: do NOT put access keys here. Production (Cloud Run) sends
# keylessly via federation (SES_AWS_ROLE_ARN, set by .github/workflows/deploy-gcp.yml).
# Locally, SES_AWS_ROLE_ARN is left unset and the AWS SDK's default credential
# chain is used (e.g. `aws sso login` / AWS_PROFILE in ~/.aws).

# Required: Email address for sending emails
# This email must be verified in SES before use
SES_FROM_EMAIL=noreply@example.com

# Required: Default recipient email address for contact form submissions
SES_TO_EMAIL=contact@example.com

# Optional: AWS Region for SES (defaults to ap-northeast-1 if not set)
# SES_REGION=ap-northeast-1

# Production only: IAM role assumed via Google OIDC federation on Cloud Run.
# Leave unset locally (there is no GCP metadata server to issue the ID token).
# SES_AWS_ROLE_ARN=

# =============================================================================
# Analytics (Google Tag Manager)
# =============================================================================
# Optional: GTM container ID (e.g. GTM-XXXXXXX). When unset, no analytics
# script loads (local/preview environments). GA4 is connected via a tag
# inside the GTM container. Events are pushed to dataLayer by
# src/app/_lib/analytics.ts.
# NEXT_PUBLIC_GTM_ID=

# =============================================================================
# IMPORTANT: SES Sandbox Mode
# =============================================================================
# New AWS accounts are in SES sandbox mode by default.
# In sandbox mode, you can ONLY send emails to verified email addresses.
# 
# To verify an email address:
# 1. Go to AWS Console > SES > Verified identities
# 2. Click "Create identity" > Select "Email address"
# 3. Enter the email address and click "Create identity"
# 4. Check your email and click the verification link
#
# To request production access:
# 1. Go to AWS Console > SES > Account dashboard
# 2. Click "Request production access"
# 3. Fill out the form explaining your use case
# 4. Wait for AWS approval (usually 24-48 hours)
# =============================================================================
