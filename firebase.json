{
  "hosting": {
    "site": "tarophotos-web",
    "public": "firebase-empty",
    "ignore": ["**/.*"],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "tarophotos",
          "region": "asia-northeast1"
        }
      }
    ]
  }
}
