# 手元で CDK を synth / deploy するときだけ使う（CI からの deploy は無い）。
# 認証は静的キーではなく `aws sso login` 等の一時クレデンシャルで行うこと。
# ⚠️ stack 名 `SesStack` は同一アカウントの i-willink.com の stack と衝突する。
#    衝突を解消するまで deploy しないこと（i-willink.com の SES ID を上書きする。ci.yml 末尾参照）。
AWS_DEFAULT_REGION=ap-northeast-1

# =============================================================================
# SES Configuration (Optional - for contact form email functionality)
# =============================================================================
# Email address for sending emails (requires verification in SES)
SES_FROM_EMAIL=noreply@example.com

# Default recipient email address for contact form submissions
SES_TO_EMAIL=contact@example.com

# AWS Region for SES (defaults to CDK_DEFAULT_REGION if not set)
SES_REGION=ap-northeast-1

# Domain for SES (alternative to email verification, recommended for production)
# When using domain verification, all email addresses under this domain can send emails
# SES_DOMAIN=example.com

# =============================================================================
# Route53 Configuration (Required for automatic DKIM setup)
# =============================================================================
# If your domain is managed by Route53, set this to automatically create
# DKIM CNAME records for SES domain verification.
# You can find the Hosted Zone ID in Route53 console > Hosted zones
# ROUTE53_HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ

# =============================================================================
# IMPORTANT: SES Sandbox Mode
# =============================================================================
# New AWS accounts are in SES sandbox mode by default.
# In sandbox mode, you can ONLY send emails to verified email addresses.
# 
# To use SES in production:
# 1. Go to AWS Console > SES > Account dashboard
# 2. Click "Request production access"
# 3. Fill out the form explaining your use case
# 4. Wait for AWS approval (usually 24-48 hours)
# =============================================================================
